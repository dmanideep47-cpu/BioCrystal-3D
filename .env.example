# ========================================================
# BioCrystal 3D — Environment Configuration Template
# ========================================================

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development

# Frontend Configuration
# In local development: leave empty to use Vite proxy (/api -> http://127.0.0.1:8000)
# In production deployment: set to your public backend origin (e.g., https://api.biocrystal3d.org)
VITE_API_BASE_URL=

# Port for Vite local dev server
PORT=5173
